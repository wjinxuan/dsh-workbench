{
  "name": "dsh-devwork",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "开发工作台：在 DeepSeek Harness 里用项目组织设计、产品、开发、测试任务——多项目并行看板、今日焦点、实时状态与活动流。",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src",
    "locale",
    "icon.svg",
    "docs",
    "README.md",
    "DESIGN.md",
    "CONTRACT.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dev-workbench",
    "task-management",
    "kanban",
    "multi-project",
    "project-management",
    "real-time"
  ],
  "author": {
    "name": "wjinxuan",
    "url": "https://github.com/wjinxuan"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjinxuan/dsh-workbench.git"
  },
  "homepage": "https://github.com/wjinxuan/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/wjinxuan/dsh-workbench/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check src/store.js && node --check src/util.js"
  }
}
